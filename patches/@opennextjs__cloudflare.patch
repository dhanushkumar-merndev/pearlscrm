+/**
+ * Next 16's `NextNodeServer.getMiddlewareManifest` does
+ * `require(this.middlewareManifestPath)` — a dynamic require workerd rejects
+ * at runtime with `Dynamic require of "/.next/server/middleware-manifest.json"
+ * is not supported`, which 500s every page.
+ *
+ * Returning `null` is what Next itself does in minimal mode. It is the correct
+ * answer under OpenNext regardless: middleware is bundled separately into
+ * `.open-next/middleware/handler.mjs` and invoked by the Worker entrypoint
+ * before the Next server ever runs, so the server must not try to run it again.
+ * `getMiddleware()` already handles a null manifest, and `loadNodeMiddleware`
+ * is stubbed out just above.
+ */
+export const disableMiddlewareManifestRule = `
+rule:
+  pattern:
+    selector: method_definition
+    context: "class { getMiddlewareManifest($$$PARAMS) { $$$_ } }"
+fix: |-
+  getMiddlewareManifest($$$PARAMS) {
+    // patched by open next: middleware runs in the Worker entrypoint
+    return null;
+  }
+`;
 // Do not try to load Node middlewares
