# Copy to .env and fill in. Never commit real values.

# --- Supabase (public: reaches the browser) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only: must NEVER reach the browser) --------------------
SUPABASE_SERVICE_ROLE_KEY=

# --- Tigris private object storage (server only) -----------------------------
# The bucket must be PRIVATE.
TIGRIS_ENDPOINT=
TIGRIS_REGION=
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# --- Tunables (optional; defaults shown) -------------------------------------
UPLOAD_URL_TTL_SECONDS=1800
READ_URL_TTL_SECONDS=1800
MAX_IMAGE_BYTES=5242880

# --- Firebase web push (public: reaches the browser) --------------------------
# Same Firebase project as Pearl Sales CRM. Firebase Console -> Project settings
# -> General -> Your apps -> Web app config. Web only; no Android.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console -> Project settings -> Cloud Messaging -> Web Push certificates -> Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Cloud Messaging sender (server only) ----------------------------
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Paste the JSON file's contents on ONE line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Shared secret Supabase sends (x-push-secret) when asking the app to deliver a push.
# Generate with: openssl rand -hex 32
PUSH_DISPATCH_SECRET=
